{
  "schema_version": 1,
  "kinds": {
    "audio": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "media_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "volume": {
          "default": 1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "start_s": {
          "default": 0,
          "type": "number",
          "minimum": 0
