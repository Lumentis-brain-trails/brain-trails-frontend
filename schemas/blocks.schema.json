        "end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "src"
          ]
        },
        {
          "required": [
            "media_id"
          ]
        }
      ]
    },
    "baseline": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
