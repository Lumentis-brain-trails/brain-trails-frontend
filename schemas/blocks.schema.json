              "text": {
                "type": "string",
                "minLength": 1
              },
              "marker": {
                "type": "string",
                "maxLength": 50
              },
              "holdMs": {
                "default": 5000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "text"
