              "choices": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "correct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "prompt",
              "choices"
            ]
          }
        },
        "feedback": {
          "default": false,
          "type": "boolean"
        }
