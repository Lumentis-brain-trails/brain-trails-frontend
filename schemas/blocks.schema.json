    "questionnaire": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instrument": {
          "type": "string",
          "enum": [
            "sam",
            "vas",
            "nasa_tlx",
            "custom"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "default": "slider",
                "type": "string",
                "enum": [
                  "likert",
                  "slider",
                  "choice"
                ]
              },
              "points": {
                "default": 7,
                "type": "integer",
                "minimum": 2,
                "maximum": 11
              },
              "anchors": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "min": {
                "default": 0,
                "type": "number"
              },
              "max": {
                "default": 100,
                "type": "number"
              },
              "choices": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "instrument"
      ]
    },
    "quiz": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
