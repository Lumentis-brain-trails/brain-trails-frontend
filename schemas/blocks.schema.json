              },
              "class": {
                "type": "string",
                "maxLength": 40
              },
              "durationMs": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "src",
              "durationMs"
            ]
          }
        },
        "isiMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jitterMs": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
