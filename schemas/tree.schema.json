{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "manifest": {
      "type": "object",
      "properties": {
        "content_warning": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_consent": {
          "default": false,
          "type": "boolean"
        },
        "consent_text": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "min_quality": {
          "default": 0.6,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "root": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schema",
    "manifest",
    "root"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sequence"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "string",
          "enum": [
            "fixed",
            "shuffle"
          ]
        },
        "max_run_same": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "children": {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "loop"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "label": {
                    "type": "string"
                  },
                  "template": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "conditions": {
                    "type": "object",
                    "properties": {
                      "columns": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "rows": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "required": [
                      "columns",
                      "rows"
                    ],
                    "additionalProperties": false
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "sequential",
                      "random"
                    ]
                  },
                  "repetitions": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "max_run_same": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "type",
                  "id",
                  "template",
                  "conditions",
                  "order"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "block"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "properties": {
                          "$var": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "$var"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "condition": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "$var": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "$var"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "pre_fixation_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "jitter_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "post_rest_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "skippable": {
                    "type": "boolean"
                  },
                  "config": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type",
                  "id",
                  "kind",
                  "label",
                  "config"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "order",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
